# Copie para .env. Use valores aleatórios, sem ponto e vírgula na senha do banco.
POSTGRES_PASSWORD=
SETUP_TOKEN=
APP_ORIGIN=http://localhost:8080
APP_ENV=Development
WEB_PORT=8080
PHOTO_STORAGE_PROVIDER=Database
S3_BUCKET=alugueis-pelada
S3_REGION=sa-east-1
# As credenciais ficam no User Secrets da API, nunca neste arquivo.
# Para publicar: APP_ENV=Production e APP_ORIGIN=https://seu-endereco.
